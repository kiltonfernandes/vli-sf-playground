# ── Turso (libSQL) — banco de dados ──
# Em dev local: deixe em branco para usar SQLite local (file:./local.db).
# Na Vercel/produção: configure ambos obrigatoriamente.
#   turso db create vli-sf-playground
#   turso db show vli-sf-playground --url      → TURSO_DATABASE_URL
#   turso db tokens create vli-sf-playground  → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
